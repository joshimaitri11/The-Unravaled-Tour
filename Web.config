<?xml version="1.0"?>
<configuration>
  <appSettings>
    <add key="AdminEmail" value="admin@unraveled.fan"/>
  </appSettings>
  <connectionStrings>
    <add name="UnraveledDb" connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=UnraveledTour;Integrated Security=True" providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8"/>
    <pages controlRenderingCompatibilityVersion="4.0" enableEventValidation="false" viewStateEncryptionMode="Never"/>
    <sessionState timeout="60"/>
    <customErrors mode="Off"/>
  </system.web>
</configuration>
