# ==============================================================================
# The Unraveled Tour - Environment Configuration Template
# Copy this file to '.env' and adjust values for your environment.
# ==============================================================================

# Web Application Port (local or container deployment)
PORT=5000

# Microsoft SQL Server SA Password (must be strong for MSSQL: uppercase, lowercase, numbers, symbols)
MSSQL_SA_PASSWORD=Password_123!

# Host Port exposed for SQL Server (default: 1433)
DB_PORT=1433

# Database Connection String for Mono XSP4 Web App
UNRAVELED_DB=Server=db,1433;Database=UnraveledTour;User Id=sa;Password=Password_123!;TrustServerCertificate=True

# Admin account email
ADMIN_EMAIL=admin@unraveled.fan
